{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "arcus-local": {
      // Data dir is still the opencode namespace — see Global.Path in
      // packages/core/src/global.ts. Update both together or agents get sent
      // to a directory that does not exist.
      "path": "~/.local/share/opencode",
      "description": "Contains Arcus Code logs and data",
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
